# Configurations
NODE_ENV=development
APP_NAME='NestJS Template API'
APP_DESCRIPTION='Reusable NestJS backend template'
APP_VERSION=1.0.0
JWT_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN_SEC=900
JWT_REFRESH_EXPIRES_IN_SEC=1209600
PORT=3000
CORS_ORIGIN=

# Rate limit
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Database
DB_ENABLED=false
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=nestjs_template
PG_SCHEMA=

# OAuth
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Delivery
EMAIL_ENABLED=false
EMAIL_SENDER_EMAIL=
EMAIL_SENDER_NAME=
EMAIL_VERIFICATION_PAGE_URL=

# OCI SDK Shared Credentials
OCI_AUTH_MODE=instance_principal
OCI_COMPARTMENT_ID=
OCI_REGION=

## DEV ONLY
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY=
