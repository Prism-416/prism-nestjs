ENV_FILE_VERSION=1.0.3
# Configurations
NODE_ENV=development
APP_NAME='NestJS Template API'
APP_DESCRIPTION='Reusable NestJS backend template'
APP_VERSION=1.0.0
JWT_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN_SEC=900
JWT_REFRESH_EXPIRES_IN_SEC=1209600
PORT=3000
CORS_ORIGIN=

# Rate limit
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Admin authentication
ADMIN_PASSWORD=
ADMIN_PASSWORD_FAILURE_LIMIT=5
ADMIN_PASSWORD_FAILURE_WINDOW_MS=300000
ADMIN_PASSWORD_BAN_MS=900000

# Database
DB_ENABLED=false
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=nestjs_template
PG_SCHEMA=

# OAuth
GOOGLE_CLIENT_ID=

# GitHub App OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_INSTALL_URL=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_STATE_SECRET=
GITHUB_APP_STATE_TTL_SEC=600
GITHUB_INSTALLATION_RESULT_PAGE_URL=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
GITHUB_OAUTH_STATE_SECRET=
GITHUB_OAUTH_STATE_TTL_SEC=600
GITHUB_OAUTH_SIGNIN_PAGE_URL=
GITHUB_OAUTH_LINK_PAGE_URL=

# Email Delivery
EMAIL_ENABLED=false
EMAIL_SENDER_EMAIL=
EMAIL_SENDER_NAME=
EMAIL_VERIFICATION_PAGE_URL=
EMAIL_WORKSPACE_INVITATION_PAGE_URL=

# OCI SDK Shared Credentials
OCI_AUTH_MODE=instance_principal
OCI_COMPARTMENT_ID=
OCI_REGION=
OBJECT_STORAGE_ENABLED=true
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_OBJECT_STORAGE_BUCKET_NAME=

## DEV ONLY
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY=

# Feature provisioning dispatch
# Use stdout in development to print the event instead of publishing to OCI queue.
FEATURE_PROVISIONING_DISPATCH_MODE=stdout
